NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://nest_user:nest_password@localhost:5432/rpg_sheets_db?schema=public"
CORS_ORIGIN=http://localhost:3001
# Secreto de firma del JWT. Minimo 32 caracteres; la app no arranca si falta o es corto.
# Generalo con: openssl rand -base64 48
# NUNCA commitear el valor real ni reusar el mismo entre ambientes.
JWT_SECRET="cambiame-por-un-secreto-largo-y-aleatorio-de-verdad"
# Vida del access token (formato ms: 15m, 2h, 7d). Default: 7d
JWT_EXPIRES_IN=7d
