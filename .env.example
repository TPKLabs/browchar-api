NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://nest_user:nest_password@localhost:5432/rpg_sheets_db?schema=public"
CORS_ORIGIN=http://localhost:3001
# Secreto de firma del JWT. Se deja VACIO a proposito: la app no arranca sin el.
# Un placeholder que pasara la validacion seria peor que no tener nada — todos
# los que clonen el repo arrancarian con la misma clave publicamente conocida, y
# cualquiera podria firmar un token valido para cualquier usuario.
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# NUNCA commitear el valor real ni reusar el mismo entre ambientes.
JWT_SECRET=
# Vida del access token (formato ms: 15m, 2h, 7d). Default: 7d
JWT_EXPIRES_IN=7d
